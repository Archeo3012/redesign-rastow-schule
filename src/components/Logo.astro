---
/** Wortbildmarke: Zahnrad (Hommage an Ernst Alban, Dampfmaschinen-Pionier) mit Sonne/Buch. */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<span class:list={['logo', { 'logo--compact': compact }]}>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true">
    <g fill="var(--c-primary)">
      <path d="M24 2.5l3.1 4.6 5.4-1.2 1.1 5.4 5.3 1.7-1.4 5.3 4 3.8-4 3.8 1.4 5.3-5.3 1.7-1.1 5.4-5.4-1.2L24 45.5l-3.1-4.6-5.4 1.2-1.1-5.4-5.3-1.7 1.4-5.3-4-3.8 4-3.8-1.4-5.3 5.3-1.7 1.1-5.4 5.4 1.2z"/>
    </g>
    <circle cx="24" cy="24" r="12.5" fill="var(--c-bg)"/>
    <circle cx="24" cy="21" r="5" fill="var(--c-accent)"/>
    <path d="M14.5 30.5c3.2-1.6 6.3-1.6 9.5 0 3.2-1.6 6.3-1.6 9.5 0v2.6c-3.2-1.6-6.3-1.6-9.5 0-3.2-1.6-6.3-1.6-9.5 0z" fill="var(--c-primary)"/>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Ernst-Alban-Schule</span>
    {!compact && <span class="logo__sub">Regionale Schule mit Grundschule · Rastow</span>}
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--c-text); }
  .logo__mark { width: 46px; height: 46px; flex: none; transition: transform 0.6s ease; }
  :global(a:hover) > .logo .logo__mark { transform: rotate(45deg); }
  .logo__text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo__name { font-family: var(--font-display); font-weight: 650; font-size: 1.2rem; letter-spacing: -0.01em; }
  .logo__sub { font-size: 0.74rem; color: var(--c-muted); margin-top: 0.2rem; }
  @media (max-width: 420px) { .logo__sub { display: none; } }
</style>
