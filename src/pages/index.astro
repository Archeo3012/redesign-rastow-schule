---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import Icon from '../components/Icon.astro';
import NewsCard from '../components/NewsCard.astro';
import EventList from '../components/EventList.astro';
import { school, url, formatDate } from '../lib/site';

const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const today = new Date(new Date().toDateString());
const events = (await getCollection('termine'))
  .filter((e) => (e.data.end ?? e.data.date) >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 4);
const nextEvent = events[0];

const quick = [
  { icon: 'laptop', title: 'itslearning', text: 'Aufgaben, Vertretungsplan & Nachrichten', href: school.itslearning, external: true },
  { icon: 'bandage', title: 'Krankmeldung', text: 'Bitte bis 7:30 Uhr im Sekretariat melden', href: url('service/#krankmeldung') },
  { icon: 'calendar', title: 'Termine & Ferien', text: 'Alle Veranstaltungen im Überblick', href: url('termine/') },
  { icon: 'bus', title: 'Schulbus & Mensa', text: 'Fahrpläne, Speiseplan und Bestellung', href: url('service/#schulbus') },
] as const;
---
<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Grundschule &amp; Regionale Schule · Rastow</p>
        <h1>Hier wächst <span class="hl">Zukunft</span> – mitten in Rastow.</h1>
        <p class="lead">Von der Einschulung bis zum Abschluss: An der Ernst-Alban-Schule lernen Kinder und Jugendliche der Klassen 1 bis 10 gemeinsam unter einem Dach – persönlich, praxisnah und mit Freude an Neuem.</p>
        <div class="hero__actions">
          <a class="btn" href={url('ueber-uns/')}>Schule kennenlernen <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href={url('termine/')}>Termine ansehen</a>
        </div>
      </div>
      <div class="hero__art">
        <HeroArt />
        {nextEvent && (
          <a class="hero__chip hero__chip--event" href={url('termine/')}>
            <span class="icon-badge icon-badge--accent"><Icon name="calendar" /></span>
            <span><small>Nächster Termin</small><strong>{nextEvent.data.title}</strong><small>{formatDate(nextEvent.data.date)}</small></span>
          </a>
        )}
        <div class="hero__chip hero__chip--grades" aria-hidden="true">
          <strong>1–10</strong><span>Klassen unter<br />einem Dach</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SCHNELLZUGRIFF -->
  <section class="container quick" aria-labelledby="quick-title">
    <h2 id="quick-title" class="visually-hidden">Schnellzugriff</h2>
    <ul class="quick__grid">
      {quick.map((q) => (
        <li class="card card--link quick__item">
          <span class="icon-badge"><Icon name={q.icon} /></span>
          <div>
            <h3><a href={q.href} rel={'external' in q ? 'noopener' : undefined}>{q.title}</a></h3>
            <p>{q.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- ZWEI SCHULEN -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Unsere Schule</p>
          <h2>Zwei Schularten. Ein Zuhause.</h2>
        </div>
        <p class="lead" style="max-width:48ch">Kurze Wege, vertraute Gesichter und ein fließender Übergang von Klasse 4 nach Klasse 5.</p>
      </div>
      <div class="grid grid--2">
        <article class="card card--link school-card school-card--primary reveal">
          <span class="school-card__num" aria-hidden="true">1–4</span>
          <p class="eyebrow">Grundschule</p>
          <h3><a href={url('grundschule/')}>Ankommen, entdecken, wachsen</a></h3>
          <p>Kleine Klassen, verlässliche Betreuung und viel Raum zum Spielen und Ausprobieren. Hier legen wir das Fundament fürs Lesen, Schreiben, Rechnen – und für Freundschaften.</p>
          <span class="school-card__more">Zur Grundschule <Icon name="arrow" size={18} /></span>
        </article>
        <article class="card card--link school-card school-card--accent reveal">
          <span class="school-card__num" aria-hidden="true">5–10</span>
          <p class="eyebrow">Regionale Schule</p>
          <h3><a href={url('regionale-schule/')}>Stark für Ausbildung und Beruf</a></h3>
          <p>Berufsreife oder Mittlere Reife – mit Praxistagen, Partnerbetrieben aus der Region und individueller Förderung bereiten wir auf den nächsten großen Schritt vor.</p>
          <span class="school-card__more">Zur Regionalen Schule <Icon name="arrow" size={18} /></span>
        </article>
      </div>
    </div>
  </section>

  <!-- NEUIGKEITEN -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Aus dem Schulleben</p>
          <h2>Neuigkeiten</h2>
        </div>
        <a class="btn btn--ghost" href={url('neuigkeiten/')}>Alle Beiträge <Icon name="arrow" /></a>
      </div>
      <div class="grid grid--3">
        {news.map((post) => <NewsCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- TERMINE + FAKTEN -->
  <section class="section">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">Demnächst</p>
        <h2>Termine</h2>
        <EventList events={events} compact />
        <p style="margin-top:1.5rem"><a class="btn btn--ghost" href={url('termine/')}>Zum Kalender <Icon name="arrow" /></a></p>
      </div>
      <div class="facts reveal">
        <div class="fact fact--primary"><strong>10</strong><span>Jahrgänge an einem Ort</span></div>
        <div class="fact fact--accent"><strong>6+</strong><span>AGs am Nachmittag</span></div>
        <div class="fact fact--leaf"><strong>1</strong><span>Schulgarten zum Mitmachen</span></div>
        <div class="fact fact--coral"><strong>∞</strong><span>Neugier &amp; Ideen</span></div>
      </div>
    </div>
  </section>

  <!-- NAMENSGEBER -->
  <section class="section section--tint alban">
    <div class="container split split--reverse">
      <div class="alban__art reveal" aria-hidden="true">
        <svg viewBox="0 0 200 200" class="alban__gear">
          <path class="alban__teeth" fill="var(--c-primary)" d="M100 10l12 18 21-5 4 21 21 7-6 21 16 15-16 15 6 21-21 7-4 21-21-5-12 18-12-18-21 5-4-21-21-7 6-21-16-15 16-15-6-21 21-7 4-21 21 5z"/>
          <circle cx="100" cy="100" r="46" fill="var(--c-surface-2)"/>
          <text x="100" y="96" text-anchor="middle" font-family="var(--font-display)" font-size="22" font-weight="650" fill="var(--c-primary)">1791</text>
          <text x="100" y="122" text-anchor="middle" font-family="var(--font-display)" font-size="22" font-weight="650" fill="var(--c-coral)">1856</text>
        </svg>
      </div>
      <div class="reveal">
        <p class="eyebrow">Unser Namensgeber</p>
        <h2>Dr. Ernst Alban – Arzt, Erfinder, Mutmacher</h2>
        <p>Ernst Alban war Augenarzt und einer der großen Pioniere des Dampfmaschinenbaus in Mecklenburg. Er hat sich nie mit dem Bestehenden zufriedengegeben, sondern ausprobiert, verbessert und neu gedacht.</p>
        <p>Genau diese Haltung wünschen wir uns für unsere Schülerinnen und Schüler: neugierig sein, Fragen stellen, Dinge selbst in die Hand nehmen.</p>
        <a class="btn btn--ghost" href={url('ueber-uns/#namensgeber')}>Mehr über Ernst Alban <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container cta reveal">
    <div>
      <h2>Lernen Sie uns kennen!</h2>
      <p>Sie überlegen, Ihr Kind bei uns anzumelden? Wir zeigen Ihnen gern unsere Schule – beim Tag der offenen Tür oder in einem persönlichen Gespräch.</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--accent" href={url('kontakt/')}>Kontakt aufnehmen <Icon name="arrow" /></a>
      <a class="btn cta__ghost" href={`tel:${school.phoneHref}`}><Icon name="phone" /> {school.phone}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: clamp(32px, 6vw, 80px) clamp(64px, 8vw, 110px);
    background:
      radial-gradient(45% 60% at 85% 20%, var(--c-accent-soft), transparent 70%),
      radial-gradient(40% 60% at 0% 90%, var(--c-primary-soft), transparent 70%);
  }
  .hero__inner { display: grid; gap: clamp(32px, 5vw, 64px); align-items: center; }
  @media (min-width: 960px) { .hero__inner { grid-template-columns: 1.1fr 1fr; } }
  .hero h1 { max-width: 14ch; }
  .hl { position: relative; isolation: isolate; color: var(--c-primary); white-space: nowrap; }
  .hl::after {
    content: ''; position: absolute; left: -2%; right: -2%; bottom: 0.06em; height: 0.28em; z-index: -1;
    background: var(--c-accent); opacity: 0.55; border-radius: 999px; transform: rotate(-1.5deg);
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero__art { position: relative; max-width: 560px; justify-self: center; width: 100%; }
  .hero__chip {
    position: absolute; display: flex; align-items: center; gap: 0.8rem;
    background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius);
    padding: 12px 16px 12px 12px; box-shadow: var(--shadow-md); color: var(--c-text); text-decoration: none;
  }
  .hero__chip small { display: block; font-size: 0.78rem; color: var(--c-muted); }
  .hero__chip strong { display: block; font-size: 0.98rem; line-height: 1.25; }
  .hero__chip--event { left: -4%; bottom: 2%; max-width: 280px; animation: bob 7s ease-in-out infinite; }
  .hero__chip--event:hover { border-color: var(--c-primary); }
  .hero__chip--grades { right: -2%; top: 6%; flex-direction: column; gap: 0; text-align: center; padding: 12px 18px; animation: bob 7s 1.5s ease-in-out infinite; }
  .hero__chip--grades strong { font-family: var(--font-display); font-size: 2rem; color: var(--c-primary); line-height: 1; }
  .hero__chip--grades span { font-size: 0.78rem; color: var(--c-muted); line-height: 1.3; }
  @keyframes bob { 50% { transform: translateY(-6px); } }
  @media (max-width: 520px) {
    .hero__chip--event { position: relative; left: 0; bottom: 0; margin-top: -24px; max-width: none; }
    .hero__chip--grades { display: none; }
  }

  .quick { margin-top: clamp(-70px, -6vw, -40px); position: relative; z-index: 2; }
  .quick__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .quick__item { display: flex; gap: 1rem; align-items: flex-start; padding: 20px; }
  .quick__item h3 { font-family: var(--font-body); font-size: 1.05rem; margin: 0.1rem 0 0.25rem; }
  .quick__item p { margin: 0; font-size: 0.93rem; color: var(--c-muted); line-height: 1.45; }

  .school-card { overflow: hidden; padding: clamp(28px, 4vw, 44px); min-height: 320px; display: flex; flex-direction: column; }
  .school-card h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); max-width: 16ch; }
  .school-card p:not(.eyebrow) { color: var(--c-muted); max-width: 46ch; }
  .school-card__num {
    position: absolute; right: -0.05em; bottom: -0.25em; font-family: var(--font-display); font-weight: 700;
    font-size: clamp(6rem, 14vw, 10rem); line-height: 1; letter-spacing: -0.04em; pointer-events: none;
  }
  .school-card--primary { background: linear-gradient(160deg, var(--c-surface) 40%, var(--c-primary-soft)); }
  .school-card--primary .school-card__num { color: color-mix(in srgb, var(--c-primary) 14%, transparent); }
  .school-card--accent { background: linear-gradient(160deg, var(--c-surface) 40%, var(--c-accent-soft)); }
  .school-card--accent .school-card__num { color: color-mix(in srgb, var(--c-accent) 30%, transparent); }
  .school-card__more { margin-top: auto; font-weight: 700; color: var(--c-primary); display: inline-flex; align-items: center; gap: 0.4rem; position: relative; }


  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .fact {
    --tone: var(--c-primary);
    border-radius: var(--radius); padding: clamp(20px, 3vw, 32px); min-height: 170px;
    display: flex; flex-direction: column; justify-content: flex-end;
    background: color-mix(in srgb, var(--tone) 13%, var(--c-surface));
  }
  .fact strong { font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 3.6rem); line-height: 1; color: var(--tone); }
  .fact span { font-weight: 700; margin-top: 0.4rem; }
  .fact--accent { --tone: color-mix(in srgb, var(--c-accent) 75%, var(--c-coral)); }
  .fact--leaf { --tone: var(--c-leaf); }
  .fact--coral { --tone: var(--c-coral); }
  .fact:nth-child(2) { transform: translateY(24px); }
  .fact:nth-child(4) { transform: translateY(24px); }

  .alban__art { display: grid; place-items: center; }
  .alban__gear { width: min(320px, 80%); }
  .alban__teeth { animation: spin 40s linear infinite; transform-box: view-box; transform-origin: 100px 100px; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .cta {
    margin-top: var(--section);
    display: grid; gap: 1.5rem; align-items: center;
    background: var(--c-primary); color: var(--c-on-primary);
    border-radius: var(--radius-lg); padding: clamp(28px, 5vw, 56px);
    background-image: radial-gradient(50% 120% at 100% 0%, rgb(255 255 255 / 0.14), transparent 60%);
  }
  @media (min-width: 900px) { .cta { grid-template-columns: 1.4fr auto; } }
  .cta h2 { color: inherit; }
  .cta p { margin: 0; opacity: 0.9; max-width: 56ch; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .cta__ghost { --btn-bg: transparent; --btn-fg: var(--c-on-primary); border-color: currentColor; }
</style>
